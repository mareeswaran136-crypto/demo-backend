{
  "info": {
    "name": "SAVÉRA — Crew Management & Rosters API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for SAVÉRA Crew Management & Rosters"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "crewId", "value": "" },
    { "key": "flightId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Login (Get JWT Token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"department\": \"OCC\",\n  \"identifier\": \"rajesh.varma@savera.aero\",\n  \"passcode\": \"YOUR_SEED_PASSWORD\"\n}"
        }
      }
    },
    {
      "name": "1. Get All Crew (with role, dutyStatus, search)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/crew?role=All&dutyStatus=All&search="
      }
    },
    {
      "name": "2. Get Crew Summary Counts (GET /api/crew/stats/summary)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/crew/stats/summary"
      }
    },
    {
      "name": "3. Create Crew Member (POST /api/crew)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set('crewId', pm.response.json().crew._id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/crew",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"crewId\": \"CRW-1021\",\n  \"fullName\": \"Capt. Arjun Mehta\",\n  \"officialEmail\": \"arjun.mehta@savera.aero\",\n  \"phone\": \"+91-9876543210\",\n  \"crewRole\": \"Captain\",\n  \"subRole\": \"Senior Line Captain\",\n  \"aircraftType\": \"Boeing 787-9\",\n  \"dutyStatus\": \"Standby\",\n  \"flightHoursLogged\": 4200,\n  \"certifications\": [\"ATPL\", \"B787-9 Type Rating\"]\n}"
        }
      }
    },
    {
      "name": "4. Get Crew Profile by ID (GET /api/crew/:id)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/crew/{{crewId}}"
      }
    },
    {
      "name": "5. Update Crew Details (PUT /api/crew/:id)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/crew/{{crewId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"aircraftType\": \"Boeing 787-9 / A350\"\n}"
        }
      }
    },
    {
      "name": "6. Update Duty Status to Rest Period (PATCH /api/crew/:id/duty-status)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/crew/{{crewId}}/duty-status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dutyStatus\": \"Rest Period\"\n}"
        }
      }
    },
    {
      "name": "7. Assign Flight During Rest Period (Expect 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('Rest Period blocks assignment', () => pm.response.to.have.status(400));"],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/crew/{{crewId}}/assign-flight",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"flightId\": \"{{flightId}}\"\n}"
        }
      }
    },
    {
      "name": "8. Deactivate Crew Member (DELETE /api/crew/:id)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/crew/{{crewId}}"
      }
    },
    {
      "name": "9. Unauthorized Access (No Token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/crew"
      }
    }
  ]
}
