{
  "info": {
    "name": "SAVÉRA — Flight Operations Schedule API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for SAVÉRA Flight Operations Schedule, Crew, Filters, Search, and Status Management"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "flightId", "value": "" },
    { "key": "crewId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Login (Get JWT Token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"department\": \"OCC\",\n  \"identifier\": \"rajesh.varma@savera.aero\",\n  \"passcode\": \"YOUR_SEED_PASSWORD\"\n}"
        }
      }
    },
    {
      "name": "1. Get All Flights (GET /api/flights)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/flights"
      }
    },
    {
      "name": "2. Get Crew Members (GET /api/staff/crew)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const crew = pm.response.json().crew;",
              "if (crew && crew.length > 0) pm.collectionVariables.set('crewId', crew[0]._id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/staff/crew"
      }
    },
    {
      "name": "3. Create Flight (POST /api/flights)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set('flightId', pm.response.json().flight._id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/flights",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"flightNumber\": \"SVR-777\",\n  \"origin\": \"DEL\",\n  \"destination\": \"JFK\",\n  \"scheduledDeparture\": \"2026-11-26T16:00:00.000Z\",\n  \"scheduledArrival\": \"2026-11-27T04:30:00.000Z\",\n  \"flightStatus\": \"Scheduled\",\n  \"crewMembers\": [\"{{crewId}}\"],\n  \"gate\": \"T3-G21\"\n}"
        }
      }
    },
    {
      "name": "4. Get Flight By ID (GET /api/flights/:id)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/flights/{{flightId}}"
      }
    },
    {
      "name": "5. Update Flight (PUT /api/flights/:id)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/flights/{{flightId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"gate\": \"T3-G22\"\n}"
        }
      }
    },
    {
      "name": "6. Update Flight Status (PATCH /api/flights/:id/status)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/flights/{{flightId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"flightStatus\": \"In Flight\"\n}"
        }
      }
    },
    {
      "name": "7. Search Flights (GET /api/flights/search?q=SVR)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/flights/search?q=SVR"
      }
    },
    {
      "name": "8. Get Filter Counts (GET /api/flights/filters/counts)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/flights/filters/counts"
      }
    },
    {
      "name": "9. Delete Flight (DELETE /api/flights/:id)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/flights/{{flightId}}"
      }
    },
    {
      "name": "10. Unauthorized Access (No Token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/flights"
      }
    }
  ]
}
